generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   @default("EMPLOYEE")
  isMinor   Boolean  @default(false)
  createdAt DateTime @default(now())

  availabilities PermanentAvailability[]
  skills         EmployeeSkill[]
  requests       AvailabilityRequest[]
  shifts         Shift[]
  absences       Absence[]
}

model PermanentAvailability {
  id         Int     @id @default(autoincrement())
  employeeId Int
  dayOfWeek  Int
  isOff      Boolean @default(false)
  startTime  String?
  endTime    String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model Skill {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  employees EmployeeSkill[]
}

model EmployeeSkill {
  id         Int @id @default(autoincrement())
  employeeId Int
  skillId    Int

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
}

model AvailabilityRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  weekStart  DateTime
  status     String   @default("PENDING")
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  days     AvailabilityRequestDay[]

  @@index([employeeId, weekStart])
  @@index([status])
}

model AvailabilityRequestDay {
  id        Int     @id @default(autoincrement())
  requestId Int
  dayOfWeek Int
  mode      String  @default("SAME")
  startTime String?
  endTime   String?

  request AvailabilityRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, dayOfWeek])
}

model Shift {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  startTime  String
  endTime    String
  breakMins  Int      @default(30)
  roleName   String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([employeeId, date])
}

// Отсутствия сотрудников: отпуск, больничный и т.д. (переопределяют доступность)
model Absence {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String   @default("VACATION")
  startDate  DateTime
  endDate    DateTime
  note       String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([startDate, endDate])
}

// Прогноз заказов (GC) на день недели: 1 — понедельник … 7 — воскресенье
model Forecast {
  dayOfWeek Int      @id
  orders    Int
  updatedAt DateTime @updatedAt
}

// Данные сотрудника: телефон, дата рождения, дата приёма на работу
model EmployeeProfile {
  employeeId Int       @id
  phone      String?
  birthDate  DateTime?
  hireDate   DateTime?
  updatedAt  DateTime  @updatedAt
}
